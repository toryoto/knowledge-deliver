# X Developer API (OAuth 1.0a User Context)
# X Developer Portal > Project > App > Keys and tokens で取得
X_API_KEY=           # API Key (Consumer Key)
X_API_SECRET=        # API Key Secret (Consumer Secret)
X_ACCESS_TOKEN=      # Access Token
X_ACCESS_SECRET=     # Access Token Secret
X_USER_ID=           # 数値のユーザーID (例: 123456789)

# Redis（いいね増分カーソル保存）
REDIS_URL=redis://localhost:6379

# Spider Cloud（Webスクレイプ・本文抽出）
# https://spider.cloud/api-keys
SPIDER_API_KEY=
# 任意: smart | http | chrome（未設定時は smart）
# SPIDER_SCRAPE_REQUEST=smart

# Anthropic
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_DIGEST_CHANNEL_ID=    # #ai-x-like-notification のチャンネルID

# Agent Server
AGENT_ENDPOINT_URL=http://localhost:3000
AGENT_REQUEST_TIMEOUT_MS=180000
# MAX_PAGES=10
# MAX_COLLECT_TWEETS=20

LOG_LEVEL=info

# Sentry（未設定なら Sentry を初期化しない）
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
